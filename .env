# AgileAI - Environment Variables
# ==========================================
# Kopiere diese Datei zu `.env` und füge deine API Keys ein
# WICHTIG: Committe NIEMALS deine echten API Keys!

# Google Gemini API Key
# Erstelle einen unter: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-google-gemini-api-key

# Optional: OpenAI API Key (falls du GPT-4 verwenden möchtest)
# OPENAI_API_KEY=sk-...

# Optional: Anthropic API Key (falls du Claude verwenden möchtest)
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: Ollama Base URL (für lokale LLMs)
# OLLAMA_BASE_URL=http://localhost:11434
